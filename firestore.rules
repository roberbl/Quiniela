rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function round(roundId) { return get(/databases/$(database)/documents/rounds/$(roundId)).data; }
    match /users/{userId} { allow read: if signedIn(); allow create: if signedIn() && request.auth.uid == userId; allow update: if isAdmin() || request.auth.uid == userId; allow delete: if isAdmin(); }
    match /teams/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /settings/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /rankings/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /manualTiebreaks/{id} { allow read, write: if isAdmin(); }
    match /seasonResults/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /seasonPredictions/{userId} { allow read: if isAdmin() || request.auth.uid == userId; allow create, update: if signedIn() && request.auth.uid == userId && request.time < timestamp.date(2026, 8, 14); allow delete: if isAdmin(); }
    match /rounds/{roundId} { allow read: if signedIn(); allow write: if isAdmin();
      match /matches/{matchId} { allow read: if signedIn(); allow write: if isAdmin(); }
      match /predictions/{userId} {
        allow read: if isAdmin() || request.auth.uid == userId || round(roundId).status == 'closed';
        allow create, update: if signedIn() && request.auth.uid == userId && round(roundId).status == 'open' && request.time < round(roundId).deadline;
        allow delete: if isAdmin();
      }
    }
  }
}
